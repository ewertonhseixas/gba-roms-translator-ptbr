# Byte-compiled / otimizações Python
__pycache__/
*.py[cod]
*$py.class

# ROMs, Imagens de Disco e Saves (Proibida distribuição de material com copyright)
*.gba
*.sav
*.srm
*.dsv
*.ss[0-9]
*.sgm
*.zip
*.7z
*.rar
*.tar
*.gz
*.iso
*.bin
!**/rom/.gitkeep
!**/rom/COLOQUE_SUA_ROM_AQUI.txt

# Projetos de jogos individuais (o repositório mantém estritamente processos e ferramentas)
jogos/*
!jogos/_MODELO_NOVO_JOGO/
!jogos/_MODELO_NOVO_JOGO/**

